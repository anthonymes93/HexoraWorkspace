{
  "name": "hexora-workspace",
  "version": "0.4.0",
  "private": true,
  "description": "Hexora Workspace with SQLite-backed on-demand browser tabs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "benchmark:tabs": "node --experimental-sqlite scripts/benchmark-tabs.cjs",
    "test:code-projects": "node --experimental-sqlite --test scripts/test-code-projects.cjs",
    "test:code-session": "node --test scripts/test-code-session.cjs",
    "test:code-bridge": "node --test scripts/test-code-bridge.cjs",
    "test:code-auto-project": "node --test scripts/test-code-auto-project.cjs",
    "test:code-project-sync": "node --test scripts/test-code-project-sync.cjs",
    "test:project-picker": "node --test scripts/test-project-picker.cjs",
    "test:project-picker-ui": "node --check project-picker.js && node --check toolbar.js && node --check main.js",
    "test:links": "node --test scripts/test-deep-links.cjs"
  },
  "devDependencies": {
    "electron": "^38.0.0"
  },
  "build": {
    "protocols": [
      {
        "name": "Hexora Workspace",
        "schemes": [
          "hexora"
        ]
      }
    ]
  }
}
