{
  "name": "hexora-session-bridge",
  "displayName": "Hexora Session Bridge",
  "description": "Automatically associates a Hexora VS Code tab with its project and restores the last active editor.",
  "publisher": "hexora",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  }
}
